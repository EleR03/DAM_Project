digraph G {
graph [layout=neato, bgcolor=white, pad=0.4, splines=polyline, fontname="DejaVu Sans", label="Elide Events – Diagrama bazei de date (PostgreSQL)", labelloc=t, fontsize=26];
node [shape=plaintext, fontname="DejaVu Sans", fontsize=11]; edge [fontname="DejaVu Sans", fontsize=9, color="#526779", arrowsize=1.0, penwidth=1.2];
utilizator [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2" COLOR="#42617D"><TR><TD COLSPAN="3" BGCOLOR="#E3EAF4" BORDER="1" SIDES="B" COLOR="#42617D"><B>utilizator</B></TD></TR><TR><TD ALIGN="LEFT" WIDTH="34"><FONT COLOR="#AA3333" POINT-SIZE="9">PK</FONT></TD><TD ALIGN="LEFT"><B>id</B></TD><TD ALIGN="LEFT"><FONT COLOR="#555555">UUID</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="34"> </TD><TD ALIGN="LEFT">nume</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">VARCHAR(100)</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="34"><FONT COLOR="#AA3333" POINT-SIZE="9">UK</FONT></TD><TD ALIGN="LEFT">email</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">VARCHAR(255)</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="34"> </TD><TD ALIGN="LEFT">parola_hash</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">VARCHAR(255)</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="34"> </TD><TD ALIGN="LEFT">tip_utilizator</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">VARCHAR(15)</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="34"> </TD><TD ALIGN="LEFT">email_confirmat</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">BOOLEAN</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="34"> </TD><TD ALIGN="LEFT">activ</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">BOOLEAN</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="34"> </TD><TD ALIGN="LEFT">creat_la</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">TIMESTAMPTZ</FONT></TD></TR></TABLE>>, pos="11.0,0.0!"];
