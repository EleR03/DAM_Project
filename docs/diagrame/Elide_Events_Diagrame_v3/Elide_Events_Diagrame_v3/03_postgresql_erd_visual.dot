categorie_bilet -> rezervare_item [dir=both, arrowtail=teetee, arrowhead=crowodot, label=" selectată în"];
loc -> rezervare_item [dir=both, arrowtail=teeodot, arrowhead=crowodot, label=" alocat (opțional)"];
rezervare -> plata [dir=both, arrowtail=teetee, arrowhead=crowodot, label=" are încercări"];
rezervare_item -> bilet [dir=both, arrowtail=teetee, arrowhead=crowodot, label=" generează"];
