sala -> eveniment [dir=both, arrowtail=teeodot, arrowhead=crowodot, label=" folosită (opțional)"];
sala -> loc [dir=both, arrowtail=teetee, arrowhead=crowodot, label=" conține"];
eveniment -> categorie_bilet [dir=both, arrowtail=teetee, arrowhead=crowodot, label=" definește"];
eveniment -> rezervare [dir=both, arrowtail=teetee, arrowhead=crowodot, label=" primește"];
