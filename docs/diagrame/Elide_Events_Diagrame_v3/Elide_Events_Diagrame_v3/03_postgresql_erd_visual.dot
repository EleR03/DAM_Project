plata [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2" COLOR="#B5604F"><TR><TD COLSPAN="3" BGCOLOR="#FBE6E1" BORDER="1" SIDES="B" COLOR="#B5604F"><B>plata</B></TD></TR><TR><TD ALIGN="LEFT" WIDTH="34"><FONT COLOR="#AA3333" POINT-SIZE="9">PK</FONT></TD><TD ALIGN="LEFT"><B>id</B></TD><TD ALIGN="LEFT"><FONT COLOR="#555555">UUID</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="34"><FONT COLOR="#AA3333" POINT-SIZE="9">FK</FONT></TD><TD ALIGN="LEFT">rezervare_id</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">UUID</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="34"> </TD><TD ALIGN="LEFT">furnizor</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">VARCHAR(20)</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="34"> </TD><TD ALIGN="LEFT">referinta_tranzactie</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">VARCHAR(255)</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="34"> </TD><TD ALIGN="LEFT">suma</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">NUMERIC(10,2)</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="34"> </TD><TD ALIGN="LEFT">moneda</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">CHAR(3)</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="34"> </TD><TD ALIGN="LEFT">stare</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">VARCHAR(20)</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="34"> </TD><TD ALIGN="LEFT">creata_la</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">TIMESTAMPTZ</FONT></TD></TR></TABLE>>, pos="-5.0,-11.5!"];
bilet [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2" COLOR="#B5604F"><TR><TD COLSPAN="3" BGCOLOR="#FBE6E1" BORDER="1" SIDES="B" COLOR="#B5604F"><B>bilet</B></TD></TR><TR><TD ALIGN="LEFT" WIDTH="34"><FONT COLOR="#AA3333" POINT-SIZE="9">PK</FONT></TD><TD ALIGN="LEFT"><B>id</B></TD><TD ALIGN="LEFT"><FONT COLOR="#555555">UUID</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="34"><FONT COLOR="#AA3333" POINT-SIZE="9">FK</FONT></TD><TD ALIGN="LEFT">rezervare_item_id</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">UUID</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="34"><FONT COLOR="#AA3333" POINT-SIZE="9">UK</FONT></TD><TD ALIGN="LEFT">cod_qr</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">VARCHAR(64)</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="34"> </TD><TD ALIGN="LEFT">stare</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">VARCHAR(20)</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="34"> </TD><TD ALIGN="LEFT">emis_la</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">TIMESTAMPTZ</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="34"> </TD><TD ALIGN="LEFT">utilizat_la</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">TIMESTAMPTZ</FONT></TD></TR></TABLE>>, pos="-5.0,-18.5!"];
abonament_organizator [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2" COLOR="#8A8A8A"><TR><TD COLSPAN="3" BGCOLOR="#EDEDED" BORDER="1" SIDES="B" COLOR="#8A8A8A"><B>abonament_organizator</B></TD></TR><TR><TD ALIGN="LEFT" WIDTH="34"><FONT COLOR="#AA3333" POINT-SIZE="9">PK</FONT></TD><TD ALIGN="LEFT"><B>id</B></TD><TD ALIGN="LEFT"><FONT COLOR="#555555">UUID</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="34"><FONT COLOR="#AA3333" POINT-SIZE="9">FK</FONT></TD><TD ALIGN="LEFT">organizator_id</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">UUID</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="34"> </TD><TD ALIGN="LEFT">plan</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">VARCHAR(20)</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="34"> </TD><TD ALIGN="LEFT">inceput</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">TIMESTAMPTZ</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="34"> </TD><TD ALIGN="LEFT">sfarsit</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">TIMESTAMPTZ</FONT></TD></TR></TABLE>>, pos="26.5,-4.6!"];
utilizator -> participant [dir=both, arrowtail=teetee, arrowhead=teeodot, label=" specializare"];
utilizator -> organizator [dir=both, arrowtail=teetee, arrowhead=teeodot, label=" specializare"];
