loc [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2" COLOR="#4F8A57"><TR><TD COLSPAN="3" BGCOLOR="#E4F1E4" BORDER="1" SIDES="B" COLOR="#4F8A57"><B>loc</B></TD></TR><TR><TD ALIGN="LEFT" WIDTH="34"><FONT COLOR="#AA3333" POINT-SIZE="9">PK</FONT></TD><TD ALIGN="LEFT"><B>id</B></TD><TD ALIGN="LEFT"><FONT COLOR="#555555">UUID</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="34"><FONT COLOR="#AA3333" POINT-SIZE="9">FK</FONT></TD><TD ALIGN="LEFT">sala_id</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">UUID</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="34"> </TD><TD ALIGN="LEFT">rand</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">VARCHAR(10)</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="34"> </TD><TD ALIGN="LEFT">numar</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">INTEGER</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="34"> </TD><TD ALIGN="LEFT">pozitie_x</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">INTEGER</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="34"> </TD><TD ALIGN="LEFT">pozitie_y</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">INTEGER</FONT></TD></TR></TABLE>>, pos="11.0,-25.0!"];
eveniment [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2" COLOR="#B98A3A"><TR><TD COLSPAN="3" BGCOLOR="#FDF0DA" BORDER="1" SIDES="B" COLOR="#B98A3A"><B>eveniment</B></TD></TR><TR><TD ALIGN="LEFT" WIDTH="34"><FONT COLOR="#AA3333" POINT-SIZE="9">PK</FONT></TD><TD ALIGN="LEFT"><B>id</B></TD><TD ALIGN="LEFT"><FONT COLOR="#555555">UUID</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="34"><FONT COLOR="#AA3333" POINT-SIZE="9">FK</FONT></TD><TD ALIGN="LEFT">organizator_id</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">UUID</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="34"><FONT COLOR="#AA3333" POINT-SIZE="9">FK</FONT></TD><TD ALIGN="LEFT">locatie_id</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">UUID</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="34"><FONT COLOR="#AA3333" POINT-SIZE="9">FK</FONT></TD><TD ALIGN="LEFT">sala_id</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">UUID</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="34"> </TD><TD ALIGN="LEFT">titlu</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">VARCHAR(200)</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="34"> </TD><TD ALIGN="LEFT">descriere</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">TEXT</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="34"> </TD><TD ALIGN="LEFT">inceput</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">TIMESTAMPTZ</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="34"> </TD><TD ALIGN="LEFT">sfarsit</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">TIMESTAMPTZ</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="34"> </TD><TD ALIGN="LEFT">vizibilitate</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">VARCHAR(10)</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="34"> </TD><TD ALIGN="LEFT">stare</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">VARCHAR(20)</FONT></TD></TR></TABLE>>, pos="11.0,-11.5!"];
categorie_bilet [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2" COLOR="#B98A3A"><TR><TD COLSPAN="3" BGCOLOR="#FDF0DA" BORDER="1" SIDES="B" COLOR="#B98A3A"><B>categorie_bilet</B></TD></TR><TR><TD ALIGN="LEFT" WIDTH="34"><FONT COLOR="#AA3333" POINT-SIZE="9">PK</FONT></TD><TD ALIGN="LEFT"><B>id</B></TD><TD ALIGN="LEFT"><FONT COLOR="#555555">UUID</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="34"><FONT COLOR="#AA3333" POINT-SIZE="9">FK</FONT></TD><TD ALIGN="LEFT">eveniment_id</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">UUID</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="34"> </TD><TD ALIGN="LEFT">denumire</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">VARCHAR(100)</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="34"> </TD><TD ALIGN="LEFT">pret</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">NUMERIC(10,2)</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="34"> </TD><TD ALIGN="LEFT">moneda</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">CHAR(3)</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="34"> </TD><TD ALIGN="LEFT">capacitate</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">INTEGER</FONT></TD></TR></TABLE>>, pos="11.0,-18.5!"];
rezervare [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2" COLOR="#B5604F"><TR><TD COLSPAN="3" BGCOLOR="#FBE6E1" BORDER="1" SIDES="B" COLOR="#B5604F"><B>rezervare</B></TD></TR><TR><TD ALIGN="LEFT" WIDTH="34"><FONT COLOR="#AA3333" POINT-SIZE="9">PK</FONT></TD><TD ALIGN="LEFT"><B>id</B></TD><TD ALIGN="LEFT"><FONT COLOR="#555555">UUID</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="34"><FONT COLOR="#AA3333" POINT-SIZE="9">FK</FONT></TD><TD ALIGN="LEFT">participant_id</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">UUID</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="34"><FONT COLOR="#AA3333" POINT-SIZE="9">FK</FONT></TD><TD ALIGN="LEFT">eveniment_id</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">UUID</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="34"> </TD><TD ALIGN="LEFT">creata_la</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">TIMESTAMPTZ</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="34"> </TD><TD ALIGN="LEFT">expira_la</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">TIMESTAMPTZ</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="34"> </TD><TD ALIGN="LEFT">stare</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">VARCHAR(20)</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="34"> </TD><TD ALIGN="LEFT">total</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">NUMERIC(10,2)</FONT></TD></TR></TABLE>>, pos="3.0,-11.0!"];
