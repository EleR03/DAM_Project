locatie [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2" COLOR="#4F8A57"><TR><TD COLSPAN="3" BGCOLOR="#E4F1E4" BORDER="1" SIDES="B" COLOR="#4F8A57"><B>locatie</B></TD></TR><TR><TD ALIGN="LEFT" WIDTH="34"><FONT COLOR="#AA3333" POINT-SIZE="9">PK</FONT></TD><TD ALIGN="LEFT"><B>id</B></TD><TD ALIGN="LEFT"><FONT COLOR="#555555">UUID</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="34"> </TD><TD ALIGN="LEFT">denumire</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">VARCHAR(150)</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="34"> </TD><TD ALIGN="LEFT">adresa</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">VARCHAR(255)</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="34"> </TD><TD ALIGN="LEFT">oras</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">VARCHAR(100)</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="34"> </TD><TD ALIGN="LEFT">latitudine</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">NUMERIC(9,6)</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="34"> </TD><TD ALIGN="LEFT">longitudine</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">NUMERIC(9,6)</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="34"> </TD><TD ALIGN="LEFT">maps_place_id</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">VARCHAR(255)</FONT></TD></TR></TABLE>>, pos="19.0,-11.5!"];
