AbonamentOrganizator [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#8A8A8A"><TR><TD BGCOLOR="#EDEDED" BORDER="1" SIDES="B" COLOR="#8A8A8A"><B>AbonamentOrganizator</B></TD></TR><TR><TD ALIGN="LEFT" BORDER="0">id : UUID</TD></TR><TR><TD ALIGN="LEFT" BORDER="0">plan : PlanAbonament</TD></TR><TR><TD ALIGN="LEFT" BORDER="0">inceput : Instant</TD></TR><TR><TD ALIGN="LEFT" BORDER="0">sfarsit : Instant</TD></TR></TABLE>>, pos="26.5,-4.6!"];
Utilizator -> Participant [dir=back, arrowtail=onormal, arrowhead=none, weight=3];
Utilizator -> Organizator [dir=back, arrowtail=onormal, arrowhead=none, weight=3];
Utilizator -> Administrator [dir=back, arrowtail=onormal, arrowhead=none, weight=3];
Administrator -> Organizator [style=dashed, arrowhead=vee, label="aprobă"];
Organizator -> Eveniment [dir=none, taillabel="1", headlabel="0..*", label="organizează"];
Locatie -> Eveniment [dir=none, taillabel="1", headlabel="0..*", label="găzduiește"];
Locatie -> Sala [dir=both, arrowtail=diamond, arrowhead=none, taillabel="1", headlabel="0..*", label="conține"];
Sala -> Loc [dir=both, arrowtail=diamond, arrowhead=none, taillabel="1", headlabel="0..*", label="conține"];
Sala -> Eveniment [dir=none, taillabel="0..1", headlabel="0..*", label="folosită de (opțional)"];
Eveniment -> CategorieBilet [dir=both, arrowtail=diamond, arrowhead=none, taillabel="1", headlabel="0..*", label="definește"];
Participant -> Rezervare [dir=none, taillabel="1", headlabel="0..*", label="face"];
Eveniment -> Rezervare [dir=none, taillabel="1", headlabel="0..*", label="primește"];
Rezervare -> RezervareItem [dir=both, arrowtail=diamond, arrowhead=none, taillabel="1", headlabel="1..*", label="conține"];
CategorieBilet -> RezervareItem [dir=none, taillabel="1", headlabel="0..*", label="selectată în"];
Loc -> RezervareItem [dir=none, taillabel="0..1", headlabel="0..*", label="alocat (opțional)"];
Rezervare -> Plata [dir=none, taillabel="1", headlabel="0..*", label="are încercări de plată"];
RezervareItem -> Bilet [dir=none, taillabel="1", headlabel="0..*", label="generează după plată confirmată"];
Organizator -> AbonamentOrganizator [dir=none, taillabel="1", headlabel="0..*", label="are (extensie)",style=dashed];
Enums [pos="2,-25!", label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#42617D"><TR><TD COLSPAN="2" BGCOLOR="#E3EAF4"><B>Enumerări «enumeration»</B></TD></TR><TR><TD ALIGN="LEFT"><B>StatusAprobare</B></TD><TD ALIGN="LEFT">IN_ASTEPTARE | APROBAT | RESPINS</TD></TR><TR><TD ALIGN="LEFT"><B>Vizibilitate</B></TD><TD ALIGN="LEFT">PUBLIC | PRIVAT</TD></TR><TR><TD ALIGN="LEFT"><B>StareEveniment</B></TD><TD ALIGN="LEFT">CIORNA | PUBLICAT | ANULAT | FINALIZAT</TD></TR><TR><TD ALIGN="LEFT"><B>StareRezervare</B></TD><TD ALIGN="LEFT">ACTIVA | PLATITA | EXPIRATA | ANULATA</TD></TR><TR><TD ALIGN="LEFT"><B>StarePlata</B></TD><TD ALIGN="LEFT">INITIATA | IN_PROCESARE | CONFIRMATA | ESUATA | RAMBURSATA*</TD></TR><TR><TD ALIGN="LEFT"><B>StareBilet</B></TD><TD ALIGN="LEFT">EMIS | UTILIZAT | ANULAT</TD></TR><TR><TD ALIGN="LEFT"><B>PlanAbonament</B></TD><TD ALIGN="LEFT">GRATUIT | PRO  (valori ilustrative)</TD></TR><TR><TD COLSPAN="2" ALIGN="LEFT"><FONT POINT-SIZE="10">* RAMBURSATA: extensie neconfirmată în documentație</FONT></TD></TR></TABLE>>];
Legend [pos="-6,-18!", label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#42617D"><TR><TD COLSPAN="2" BGCOLOR="#E3EAF4"><B>Legendă</B></TD></TR><TR><TD BGCOLOR="#E3EAF4" WIDTH="18"> </TD><TD ALIGN="LEFT">Conturi și roluri</TD></TR><TR><TD BGCOLOR="#FDF0DA" WIDTH="18"> </TD><TD ALIGN="LEFT">Evenimente și categorii</TD></TR><TR><TD BGCOLOR="#E4F1E4" WIDTH="18"> </TD><TD ALIGN="LEFT">Locații, săli, locuri (Seat Map)</TD></TR><TR><TD BGCOLOR="#FBE6E1" WIDTH="18"> </TD><TD ALIGN="LEFT">Rezervare, plată, bilet</TD></TR><TR><TD BGCOLOR="#EDEDED" WIDTH="18"> </TD><TD ALIGN="LEFT">Extensie SaaS opțională</TD></TR></TABLE>>, pos="-5,-26!"];
Note1 [pos="18,-25!", shape=note, style=filled, fillcolor="#FFF8E8", color="#D7B56D", fontsize=10.5, label="Utilizator → Participant / Organizator / Administrator: specializare (moștenire).\nÎn PostgreSQL: tabelă utilizator (date comune de autentificare) + câte o tabelă\npe subtip, cu PK = FK. Statusul de aprobare cere „organizator”: atribut al subtipului.\nParola se păstrează doar ca hash (decizie standard de securitate).\nCategoria aparține evenimentului; nu există asociere permanentă Loc–CategorieBilet.\nStarea unui loc (liber / rezervat temporar / vândut) e derivată din RezervareItem."];
}