Enums [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#42617D"><TR><TD COLSPAN="2" BGCOLOR="#E3EAF4"><B>«enumeration» / Value Objects</B></TD></TR><TR><TD ALIGN="LEFT"><B>UserRole</B></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10">PARTICIPANT | ORGANIZER | ADMINISTRATOR</FONT></TD></TR><TR><TD ALIGN="LEFT"><B>AccountStatus</B></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10">PENDING | ACTIVE | SUSPENDED | DELETED | REJECTED</FONT></TD></TR><TR><TD ALIGN="LEFT"><B>EventStatus</B></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10">DRAFT | PENDING_PUBLICATION | PUBLISHED | IN_PROGRESS | COMPLETED | CANCELLED | DELETED</FONT></TD></TR><TR><TD ALIGN="LEFT"><B>SeatStatus</B></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10">AVAILABLE | HELD | SOLD | BLOCKED</FONT></TD></TR><TR><TD ALIGN="LEFT"><B>HoldStatus</B></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10">ACTIVE | EXPIRED | CONVERTED | CANCELLED</FONT></TD></TR><TR><TD ALIGN="LEFT"><B>OrderStatus</B></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10">PENDING | PAYMENT_PROCESSING | PAID | FAILED | EXPIRED | CANCELLED | REFUNDED</FONT></TD></TR><TR><TD ALIGN="LEFT"><B>TicketStatus</B></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10">ISSUED | USED | CANCELLED | REFUNDED | EXPIRED</FONT></TD></TR><TR><TD ALIGN="LEFT"><B>TicketScanResult</B></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10">VALID | ALREADY_USED | INVALID | WRONG_EVENT | CANCELLED</FONT></TD></TR></TABLE>>, pos="430,-1290!"]; Legend [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#42617D"><TR><TD COLSPAN="2" BGCOLOR="#E3EAF4"><B>Legendă</B></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">Text negru: atribut existent în codul Sprint 2</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">Text gri cursiv «țintă»: doar în structura de bază</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">Chenar punctat: clasă încă absentă din cod</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">Triunghi gol: generalizare; romb plin: compoziție</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">Săgeată punctată: dependență (referință prin id)</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">În cod, UserAccount este concretă și rolul e un enum;</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">ierarhia Participant / Organizer / Administrator este ținta</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">Ticket: în cod orderId + eventSeatId; ținta adaugă orderItemId</FONT></TD></TR></TABLE>>, pos="1000,-1420!"];
