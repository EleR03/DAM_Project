document [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2" COLOR="#7A7A7A" STYLE="dashed"><TR><TD BGCOLOR="#EDEDED" SIDES="B" BORDER="1" COLOR="#7A7A7A"><B>document</B></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10"><B>PK</B> id : UUID</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10"><B>FK</B> organizer_verification_id</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">document_type : VARCHAR(30)</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">file_url, file_hash</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">uploaded_at, verified_at</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10"><B>FK</B> verified_by</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">status : VARCHAR(20)</FONT></TD></TR></TABLE>>, pos="1250,-700!"];
subscription_plan [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2" COLOR="#7A7A7A" STYLE="dashed"><TR><TD BGCOLOR="#EDEDED" SIDES="B" BORDER="1" COLOR="#7A7A7A"><B>subscription_plan</B></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10"><B>PK</B> id : UUID</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10"><B>UK</B> name  FREE_TRIAL | MONTHLY</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">description, features</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">price : NUMERIC(10,2)</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">currency, interval</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">active : BOOLEAN</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">external_price_id</FONT></TD></TR></TABLE>>, pos="-80,-700!"];
organizer_subscription [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2" COLOR="#7A7A7A" STYLE="dashed"><TR><TD BGCOLOR="#EDEDED" SIDES="B" BORDER="1" COLOR="#7A7A7A"><B>organizer_subscription</B></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10"><B>PK</B> id : UUID</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10"><B>FK</B> organizer_id</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10"><B>FK</B> plan_id</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">status : VARCHAR(20)</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">external_customer_id</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">external_subscription_id</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">started_at, cancelled_at</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">current_period_start / end</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">grace_period_until</FONT></TD></TR></TABLE>>, pos="330,-700!"];
