role [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2" COLOR="#7A7A7A" STYLE="dashed"><TR><TD BGCOLOR="#EDEDED" SIDES="B" BORDER="1" COLOR="#7A7A7A"><B>role</B></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10"><B>PK</B> id : UUID</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10"><B>UK</B> code : VARCHAR(20)</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">PARTICIPANT | ORGANIZER |</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">ADMINISTRATOR</FONT></TD></TR></TABLE>>, pos="500,0!"];
user_account [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2" COLOR="#42617D"><TR><TD BGCOLOR="#E3EAF4" SIDES="B" BORDER="1" COLOR="#42617D"><B>user_account</B></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10"><B>PK</B> id : UUID</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10"><B>UK</B> email : VARCHAR(255)</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">password_hash : VARCHAR(255)</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">first_name, last_name</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">phone : VARCHAR(30)</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10"><B>FK</B> role_id : UUID</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">status : VARCHAR(15)</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">email_verified : BOOLEAN</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">phone_verified : BOOLEAN</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">created_at, updated_at</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">deleted_at : TIMESTAMP</FONT></TD></TR></TABLE>>, pos="900,0!"];
