digraph G {
splines=false;
graph [bgcolor=white, pad=0.4, fontname="DejaVu Sans", labelloc=t, fontsize=24, label="Elide Events – Diagrama bazei de date PostgreSQL (v7)"];
node [fontname="DejaVu Sans", fontsize=12]; edge [fontname="DejaVu Sans", fontsize=10, color="#526779", arrowsize=0.8];
node [shape=plaintext];
permission [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2" COLOR="#7A7A7A" STYLE="dashed"><TR><TD BGCOLOR="#EDEDED" SIDES="B" BORDER="1" COLOR="#7A7A7A"><B>permission</B></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10"><B>PK</B> id : UUID</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10"><B>UK</B> code : VARCHAR(50)</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">description</FONT></TD></TR></TABLE>>, pos="-200,0!"];
