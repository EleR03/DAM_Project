Notes [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#42617D"><TR><TD BGCOLOR="#E3EAF4"><B>Note</B></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">Notația «crow&#x27;s foot»: bară = exact unul; picior = mulți; cerc =<BR ALIGN="LEFT"/>opțional.</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">Gri / chenar punctat = tabele din structura de bază, încă absente din<BR ALIGN="LEFT"/>cod.</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">Conturi: user_account (+ role_id) și profiluri cu PK = FK<BR ALIGN="LEFT"/>(participant, organizer, admin).</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">Cumpărătorul (seat_hold, orders, payment, ticket) este<BR ALIGN="LEFT"/>participant_profile.</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">Tipuri conform structurii de bază (UUID); codul Sprint 2 folosește<BR ALIGN="LEFT"/>Integer.</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">Stările sunt VARCHAR cu CHECK, cu valorile enumerărilor din cod.</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">event_seat: SELECT ... FOR UPDATE la rezervare; ticket: index unic<BR ALIGN="LEFT"/>parțial pe event_seat_id.</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">FK nedesenate (redundante sau către tabele neafișate):<BR ALIGN="LEFT"/>event.category_id/location_id, seat.seat_type_id/zone_id,<BR ALIGN="LEFT"/>seat_hold.event_id, orders.event_id, payment.user_id,<BR ALIGN="LEFT"/>ticket.event_id/user_id/ticket_type_id,<BR ALIGN="LEFT"/>ticket_scan.event_id/scanned_by, order_item.ticket_type_id,<BR ALIGN="LEFT"/>event_seat.hold_id.</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">Neafișate: refresh_token, password_reset_token, seat_zone, seat_type,<BR ALIGN="LEFT"/>event_category, event_location, payment_transaction,<BR ALIGN="LEFT"/>subscription_payment, invoice, audit_log, notification, favorite,<BR ALIGN="LEFT"/>event_view.</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">«orders»: «order» este cuvânt rezervat în SQL.</FONT></TD></TR></TABLE>>, pos="-50,-2350!"];
