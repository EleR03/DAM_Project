Notes [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#42617D"><TR><TD BGCOLOR="#E3EAF4"><B>Notes</B></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">Layers: controllers (target) → business services → domain services / factory /<BR ALIGN="LEFT"/>repository → domain model.</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">All workflow operations are serialized with seatLock (sprint 2); with<BR ALIGN="LEFT"/>persistence they become transactions with row locking.</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">startPayment is called BEFORE charging: expired hold → PaymentRejectedException;<BR ALIGN="LEFT"/>otherwise the order becomes PAYMENT_PROCESSING.</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">expireHolds does not release the seats of a started payment during the grace<BR ALIGN="LEFT"/>period (5 min).</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">cancelEvent: holds released, PENDING orders → CANCELLED, PAID → REFUNDED, ISSUED<BR ALIGN="LEFT"/>tickets → REFUNDED; returns the orders to refund.</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">Event.getCapacity() counts sellable seats only (no BLOCKED);<BR ALIGN="LEFT"/>reduceCategoryCapacity blocks surplus AVAILABLE seats.</FONT></TD></TR></TABLE>>, pos="260,-1330!"];
}