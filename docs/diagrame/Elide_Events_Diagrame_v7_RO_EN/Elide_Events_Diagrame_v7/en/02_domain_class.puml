@startuml ElideEvents_Domain
title Elide Events – Domain class diagram (v7)
skinparam shadowing false
skinparam classAttributeIconSize 0
package "Identity and organizers" #F2F6FB {
  abstract class UserAccount as "UserAccount" {
    userId : Integer
    email, firstName, lastName : String
    role : UserRole
    status : AccountStatus
    isActive() : boolean
    target: passwordHash, phone,
    emailVerified, phoneVerified,
    createdAt, updatedAt, deletedAt
  }
  class Participant as "Participant" <<target>> {
    in code: role = PARTICIPANT
    target: ParticipantProfile
  }
  class Organizer as "Organizer" <<target>> {
    in code: role = ORGANIZER
    target: OrganizerProfile
  }
  class Administrator as "Administrator" <<target>> {
    in code: role = ADMINISTRATOR
    target: AdminProfile
  }
  class Company as "Company" <<target>> {
    legalName, tradeName
    registrationNumber, taxNumber
    country, city, address, postalCode
    phone, email, website
  }
  class OrgVer as "OrganizerVerification" <<target>> {
    status : PENDING | UNDER_REVIEW |
    APPROVED | REJECTED
    submittedAt, reviewedAt
    reviewedBy, rejectionReason, notes
  }
}
package "Subscriptions (target)" #F5F5F5 {
  class Plan as "SubscriptionPlan" <<target>> {
    name, description
    code : FREE_TRIAL | MONTHLY
    price, currency, interval
    active, externalPriceId
  }
  class OrgSub as "OrganizerSubscription" <<target>> {
    status : TRIAL | ACTIVE | PAST_DUE |
    GRACE_PERIOD | SUSPENDED |
    CANCELLED | EXPIRED
    startedAt, cancelledAt
    currentPeriodStart / End
    gracePeriodUntil, externalIds
  }
}
package "Events" #FFF8EA {
  class Event as "Event" <<aggregate root>> {
    eventId, organizerId : Integer
    title, description : String
    status : EventStatus
    startAt, endAt, publishedAt
    basePrice : BigDecimal
    /availableCount, heldCount,
    soldCount, blockedCount
    /capacity : int  (excludes BLOCKED seats)
    /occupancyRate : BigDecimal
    addTicketType(), addEventSeat()
    isScheduleValid(), isStructureValid()
    target: slug, category, visibility,
    salesStartAt, salesEndAt, currency,
    createdAt, updatedAt, deletedAt
  }
  class TicketType as "TicketType" {
    ticketTypeId : Integer
    name : String
    price : BigDecimal
    target: description, currency, quantity,
    soldQuantity, saleStart/End, active
  }
  class EventSeat as "EventSeat" {
    eventSeatId, seatId : Integer
    rowLabel, label : String
    status : SeatStatus
    price : BigDecimal
    holdId : Integer
    heldUntil : LocalDateTime
    isAvailable() : boolean
    target: eventId
  }
  class SalesView as "EventSalesView" <<view>> {
    capacity, available, held, sold
    scanned, notAttended
    grossRevenue, occupancyRate
    target: cancelled, taxes, netRevenue
  }
}
package "Venues and halls" #F1F8F1 {
  class Venue as "Venue" {
    venueId : Integer
    name, address, city : String
    latitude, longitude : Double
    target: country, placeId
  }
  class Hall as "Hall" <<aggregate root>> {
    hallId : Integer
    name : String
    addSeat()
    /capacity : int
    target: mapType, mapImageUrl,
    width, height
  }
  class Seat as "Seat" {
    seatId : Integer
    rowLabel : String
    seatNumber : int
    accessible, active : boolean
    /label : String
    target: x, y, zone, seatType
  }
}
package "Hold, order, payment, ticket" #FDF3F0 {
  class SeatHold as "SeatHold" <<aggregate root>> {
    holdId, userId, eventId
    createdAt, expiresAt
    status : HoldStatus
    isExpiredAt(now) : boolean
    target: updatedAt
  }
  class SeatHoldItem as "SeatHoldItem" {
    itemId, eventSeatId : Integer
  }
  class Order as "Order  (orders)" <<aggregate root>> {
    orderId, userId, eventId, holdId
    status : OrderStatus
    total : BigDecimal
    createdAt, expiresAt, paidAt
    target: subtotal, serviceFee, discount,
    tax, currency, cancelledAt
  }
  class OrderItem as "OrderItem" {
    orderItemId, eventSeatId
    seatLabel, ticketTypeName
    unitPrice : BigDecimal
    target: ticketTypeId, quantity, totalPrice
  }
  class Payment as "Payment" <<target>> {
    provider, providerPaymentId
    amount, currency, status
    paymentMethod, failureReason
    paidAt, failedAt
  }
  class Ticket as "Ticket" {
    ticketId, orderId, eventId, userId
    eventSeatId : Integer
    seatLabel, ticketTypeName
    ticketCode, qrToken : String
    status : TicketStatus
    issuedAt, usedAt
    markUsed()
    target: orderItemId, ticketTypeId,
    cancelledAt
  }
  class Scan as "TicketScan" <<target>> {
    scannedBy, scannedAt
    result : TicketScanResult
    deviceId, ipAddress
  }
  class ValView as "TicketValidationView" <<view>> {
    result : TicketScanResult
    ticketId, seatLabel, ticketTypeName
  }
}
enum UserRole {
  PARTICIPANT
  ORGANIZER
  ADMINISTRATOR
}
enum AccountStatus {
  PENDING
  ACTIVE
  SUSPENDED
  DELETED
  REJECTED
}
enum EventStatus {
  DRAFT
  PENDING_PUBLICATION
  PUBLISHED
  IN_PROGRESS
  COMPLETED
  CANCELLED
  DELETED
}
enum SeatStatus {
  AVAILABLE
  HELD
  SOLD
  BLOCKED
}
enum HoldStatus {
  ACTIVE
  EXPIRED
  CONVERTED
  CANCELLED
}
enum OrderStatus {
  PENDING
  PAYMENT_PROCESSING
  PAID
  FAILED
  EXPIRED
  CANCELLED
  REFUNDED
}
enum TicketStatus {
  ISSUED
  USED
  CANCELLED
  REFUNDED
  EXPIRED
}
enum TicketScanResult {
  VALID
  ALREADY_USED
  INVALID
  WRONG_EVENT
  CANCELLED
}
Participant "" --|> "" UserAccount
Organizer "" --|> "" UserAccount
Administrator "" --|> "" UserAccount
Organizer "1" -- "1" Company
Organizer "1" -- "0..1" OrgVer
Administrator "0..*" -- "0..*" OrgVer : reviews
Organizer "1" -- "0..*" OrgSub
Plan "1" -- "0..*" OrgSub
Event "0..*" ..> "1" Organizer : organizerId
Event "1" *-- "1..*" TicketType
Event "1" *-- "1..*" EventSeat
Event "0..*" --> "1" Hall
Hall "0..*" --> "1" Venue
Hall "1" *-- "1..*" Seat
EventSeat "0..*" ..> "1" Seat : seatId
EventSeat "0..*" --> "1" TicketType
SeatHold "1" *-- "1..*" SeatHoldItem
SeatHoldItem "0..*" ..> "1" EventSeat : eventSeatId
Order "1" *-- "1..*" OrderItem
Order "0..*" ..> "1" SeatHold : holdId
OrderItem "0..*" ..> "1" EventSeat : eventSeatId
Order "1" -- "0..*" Payment
OrderItem "1" -- "0..1" Ticket : generates
Ticket "1" -- "0..*" Scan
SalesView "" ..> "" Event
ValView "" ..> "" Ticket
@enduml
